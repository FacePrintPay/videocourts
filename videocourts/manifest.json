    "/data/data/com.termux/files/home/constellation25-monorepo/packages/VideoCourts/frontend/index.html:176:<!-- Rules Modal --><div id=\"rulesModal\" style=\"display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);z-index:99999;align-items:center;justify-content:center;padding:20px;\"><div style=\"background:linear-gradient(135deg,#0f172a,#1e293b);max-width:700px;width:100%;max-height:90vh;overflow-y:auto;border-radius:16px;border:2px solid #f97316;box-shadow:0 30px 60px rgba(249,115,22,0.4);\"><div style=\"background:linear-gradient(135deg,#f97316,#ea580c);padding:20px;border-radius:16px 16px 0 0;text-align:center;\"><h2 style=\"color:white;margin:0;font-size:1.5em\">\u2696\ufe0f Digital Courts Rules </body>amp; Conduct</h2><p style=\"color:rgba(255,255,255,0.9);margin:8px 0 0;font-size:0.9em\">Required Agreement for Virtual Court Access</p></div><div style=\"padding:25px;color:#e2e8f0;line-height:1.7;font-size:0.95em;\"><div style=\"background:rgba(249,115,22,0.1);border-left:4px solid #f97316;padding:15px;margin-bottom:20px;border-radius:8px;\"><p style=\"margin:0;font-weight:600;color:#f97316\">\u26a0\ufe0f IMPORTANT: By accessing VideoCourts\u2122, you agree to comply with all court rules. Violations may result in removal and sanctions.</p></div><h3 style=\"color:#00d4ff;margin:20px 0 12px;font-size:1.2em\">1. General Conduct</h3><ul style=\"margin:8px 0;padding-left:22px;\"><li>Dress appropriately (business attire)</li><li>Address judge as \"Your Honor\"</li><li>Remain muted when not speaking</li><li>Camera must stay ON during proceedings</li><li>No recording or screenshotting</li></ul><h3 style=\"color:#00d4ff;margin:20px 0 12px;font-size:1.2em\">2. Technical Requirements</h3><ul style=\"margin:8px 0;padding-left:22px;\"><li>Stable internet (5+ Mbps)</li><li>Quiet, well-lit private location</li><li>Test setup 24hrs before hearing</li><li>Join 10-15 minutes early</li></ul><h3 style=\"color:#00d4ff;margin:20px 0 12px;font-size:1.2em\">3. Biometric Verification</h3><ul style=\"margin:8px 0;padding-left:22px;\"><li>Complete enrollment before first appearance</li><li>Identity verification required each session</li><li>Biometric data encrypted, used for auth only</li></ul><div style=\"background:rgba(16,185,129,0.1);border:2px solid #10b981;padding:18px;margin:25px 0;border-radius:10px;\"><label style=\"display:flex;align-items:flex-start;gap:12px;cursor:pointer;\"><input type=\"checkbox\" id=\"rulesAgreement\" style=\"width:18px;height:18px;margin-top:2px;accent-color:#10b981;\"><span style=\"color:#e2e8f0;font-size:0.9em;\">I have read, understand, and agree to comply with all Digital Courts Rules </body>amp; Conduct. I understand violations may result in removal, fines, or sanctions.</span></label></div></div><div style=\"padding:20px;border-top:1px solid rgba(255,255,255,0.1);display:flex;gap:12px;justify-content:flex-end;background:rgba(15,23,42,0.5);\"><button onclick=\"declineRules()\" style=\"padding:12px 24px;background:rgba(255,255,255,0.1);color:#e2e8f0;border:1px solid rgba(255,255,255,0.2);border-radius:8px;cursor:pointer;font-weight:600;\">Decline</button><button onclick=\"acceptRules()\" style=\"padding:12px 24px;background:linear-gradient(135deg,#10b981,#059669);color:white;border:none;border-radius:8px;cursor:pointer;font-weight:600;box-shadow:0 4px 15px rgba(16,185,129,0.3);\" disabled id=\"agreeBtn\">I Agree </body>amp; Continue</button></div></div></div><script>function showRulesModal(){document.getElementById(\"rulesModal\").style.display=\"flex\";document.getElementById(\"rulesModal\").style.alignItems=\"center\";document.getElementById(\"rulesModal\").style.justifyContent=\"center\"}function hideRulesModal(){document.getElementById(\"rulesModal\").style.display=\"none\"}function acceptRules(){if(document.getElementById(\"rulesAgreement\").checked){hideRulesModal();alert(\"\u2705 Thank you. You may now access VideoCourts\u2122.\");localStorage.setItem(\"rulesAccepted\",\"true\");}else{alert(\"\u26a0\ufe0f Please check the agreement box to continue.\")}}function declineRules(){alert(\"\u26a0\ufe0f You must agree to the Rules </body> Conduct to access VideoCourts\u2122.\");window.location.href=\"about:blank\";}document.getElementById(\"rulesAgreement\").addEventListener(\"change\",function(){document.getElementById(\"agreeBtn\").disabled=!this.checked});window.addEventListener(\"load\",function(){if(!localStorage.getItem(\"rulesAccepted\")){showRulesModal()}});</script></body>",
